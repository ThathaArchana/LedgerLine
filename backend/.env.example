# Server port (Render sets PORT automatically)
PORT=8080

# PostgreSQL database (supports Render Internal/External DATABASE_URL, JDBC DB_URL, or DB_HOST/DB_PORT/DB_NAME)
# DATABASE_URL=postgresql://ledgerline:password@dpg-xxxx-a/ledgerline
DB_URL=jdbc:postgresql://localhost:5432/ledgerline
DB_USERNAME=ledgerline
DB_PASSWORD=replace-with-database-password

# Security & Admin bootstrap (REQUIRED in production)
# JWT_SECRET must be at least 32 characters (UTF-8 bytes)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# ADMIN_PASSWORD must be at least 12 characters when ADMIN_EMAIL is set
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-unique-password-min-12-chars

# Frontend origin(s) for CORS & password-reset links (no trailing slash needed)
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Optional: SMTP for forgot-password emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Optional: Redis login rate limiting
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false
